#version 430 core

layout(location = 0) in vec3 aPos;
layout(location = 1) in vec2 aTexCoord;

layout(location = 2) in vec3 aOffset;
layout(location = 3) in vec2 aZoom;
layout(location = 4) in vec2 aTexOffset;
layout(location = 5) in vec2 aTexSize;
layout(location = 6) in uvec2 aTexHandle;
layout(location = 7) in float aOpacity;

out vec2 TexCoord;
out flat uvec2 TexHandle;
out flat float Opacity;

uniform mat4 uView;

void main() {
	vec3 position = aOffset + aPos * vec3(aZoom, 1.0);
    gl_Position = uView * vec4(position, 1.0);
	
	// textures are y-axis mirrored, so it needs to invert y value of texture offset
	// TODO: switch this work to renderer
	vec2 tex_offset = aTexCoord * aTexSize + vec2(aTexOffset.x, 1. - aTexOffset.y - aTexSize.y);
	//tex_offset.x -= aTexSize.x / 2.0;
	//tex_offset.y = 1. - tex_offset.y - aTexSize.y;
	
	gl_ClipDistance[0] = min(aZoom.x, aZoom.y);
	
	TexCoord = tex_offset;
	TexHandle = aTexHandle;
	Opacity = aOpacity;
}
