#version 430 core

out vec4 FragColor;

layout(location = 0) in vec2 TexCoord;
layout(location = 1) in float TexIndex;

struct TextureInfo {
	vec2 texture_size;
	sampler2D texture;
};

// 9 tilesets textures and 1 shadow texture
uniform TextureInfo uTexturesInfos[9 + 1];

uniform float uOpacity;
uniform vec4 uColor;

void main() {
	int index = int(TexIndex);
	vec4 color = texture(uTexturesInfos[index].texture, TexCoord);
	
	color.rgb = mix(color.rgb, uColor.rgb, uColor.a);
	FragColor = color;
}