set(RMFORGE_MAJOR_VERSION "@RMFORGE_MAJOR_VERSION@")
set(RMFORGE_MINOR_VERSION "@RMFORGE_MINOR_VERSION@")
set(RMFORGE_VERSION "@RMFORGE_VERSION@")

@PACKAGE_INIT@
 
set(RMFORGE_FOUND ON)

set_and_check(RMFORGE_LIBRARY_DIRS  "${PACKAGE_PREFIX_DIR}/lib")
 
include("${PACKAGE_PREFIX_DIR}/share/rmforge/rmforge-targets.cmake")